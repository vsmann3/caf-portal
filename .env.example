# ==== Database ====
# PostgreSQL connection string. In Docker Compose this is pre-configured.
DATABASE_URL="postgresql://cafapp:cafapp_password@localhost:5432/caf_portal?schema=public"

# ==== Auth ====
# Secret used to sign session JWTs. Generate with: openssl rand -hex 32
# MUST be changed before production deployment.
AUTH_SECRET="change-me-generate-with-openssl-rand-hex-32"

# ==== App ====
# Public URL of the app (used for links, cookies in production)
APP_URL="http://localhost:3000"

# ==== Initial super admin (only used on first seed) ====
SEED_SUPER_ADMIN_EMAIL="superadmin@example.com"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe@123"

# ==== Default document storage ====
# "local" or "s3". Super admin can change this later from the admin panel.
STORAGE_DEFAULT="local"
# Local disk base path (relative paths resolve from the app working directory)
LOCAL_STORAGE_PATH="./storage"

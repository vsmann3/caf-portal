                }
              }
            ]
          }
        },
        "next_cursor": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          ]
        },
        "has_more": {
          "type": "boolean"
        },
        "snapshot_id": {
          "type": "string",
          "format": "uuid"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "continuation_cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "if": {
        "properties": {
          "has_more": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "next_cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    }
  }
}

        },
        "receipt_status": {
          "enum": [
            "accepted",
            "processing",
            "applied",
            "ignored",
            "blocked",
            "failed",
            "superseded"
          ]
        },
        "credential_accepted": {
          "type": "boolean"
        },
        "service_id": {
